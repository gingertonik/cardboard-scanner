<Window x:Class="CardScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CardScanner"
        Title="MTG Card Scanner" Height="840" Width="1280"
        Background="#1E1E22" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#3A3A44"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#4C4C5A"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E8E8EC"/></Style>
        <Style TargetType="Label"><Setter Property="Foreground" Value="#B8B8C0"/><Setter Property="Padding" Value="0"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E8E8EC"/><Setter Property="VerticalAlignment" Value="Center"/></Style>

        <!-- Explicit dark-theme styling: WPF does NOT follow the Windows 11 dark mode, so
             these controls otherwise render with system (dark-on-dark) colors. -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="Foreground" Value="#E8E8EC"/>
            <Setter Property="CaretBrush" Value="#E8E8EC"/>
            <Setter Property="BorderBrush" Value="#4A4A55"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <!-- Fully templated dark ComboBox: the stock template renders the selected item's
             text (the "selection box") with a system colour that is invisible on dark. -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E8E8EC"/>
            <Setter Property="Background" Value="#2E2E36"/>
            <Setter Property="BorderBrush" Value="#4A4A55"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="MainBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3"/>
                            <ToggleButton Focusable="False" ClickMode="Press" Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Data="M0,0 L4,4 L8,0 Z" Fill="#B8B8C0"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,0,24,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Popup x:Name="Popup" Placement="Bottom" Focusable="False" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
                                <Border Background="#26262C" BorderBrush="#4A4A55" BorderThickness="1" CornerRadius="3" Margin="0,2,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter SnapsToDevicePixels="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#6A6A7A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E8E8EC"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3D5A80"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="Foreground" Value="#E8E8EC"/>
            <Setter Property="BorderBrush" Value="#3A3A44"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E8E8EC"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#3D5A80"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#33333C"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#33333C"/>
            <Setter Property="Foreground" Value="#E8E8EC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#4A4A55"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#E8E8EC"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#E8E8EC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3D5A80"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#26262C"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.25*"/>
            <ColumnDefinition Width="1*" MinWidth="470"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <WrapPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10" VerticalAlignment="Center">
            <TextBlock Text="Device" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                      DisplayMemberPath="Name" MinWidth="200" Margin="0,0,8,0" VerticalAlignment="Center"
                      ToolTip="Video input device"/>
            <Button Content="Refresh" Command="{Binding RefreshDevicesCommand}"/>
            <Button Content="▶ Start" Command="{Binding StartCommand}"/>
            <Button Content="■ Stop" Command="{Binding StopCommand}"/>
            <CheckBox Content="Auto-add matches" IsChecked="{Binding AutoAdd}" Margin="8,0,16,0"/>
            <Separator Margin="4,0"/>
            <Button Content="Build image index" Command="{Binding BuildIndexCommand}"
                    ToolTip="Download Scryfall unique-artwork bulk data and build the perceptual-hash index."/>
            <Button Content="Build FULL index" Command="{Binding BuildFullIndexCommand}" ToolTip="Every printing — much larger and slower."/>
            <Button Content="Cancel build" Command="{Binding CancelBuildCommand}"/>
            <CheckBox Content="Auto-update index" IsChecked="{Binding AutoUpdateIndex}" Margin="8,0,0,0"
                      ToolTip="On launch, build the full index (first run) then sync only new cards periodically."/>
        </WrapPanel>

        <!-- Live feed -->
        <Border Grid.Row="1" Grid.Column="0" Background="Black" CornerRadius="6" Margin="0,0,10,0" ClipToBounds="True">
            <Grid>
                <Image Source="{Binding Preview}" Stretch="Uniform"/>
                <TextBlock Text="Live feed will appear here once you press Start." Foreground="#666"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Preview, Converter={x:Static local:NullToVisibilityConverter.Instance}}"/>

                <!-- Zoom overlay (centered digital zoom of the feed + detection input) -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12"
                        Background="#B0000000" CornerRadius="16" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍 Zoom" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#DDD"/>
                        <Slider Minimum="1" Maximum="4" Value="{Binding Zoom}" Width="180" VerticalAlignment="Center"
                                TickFrequency="0.25" IsSnapToTickEnabled="True"/>
                        <TextBlock Text="{Binding ZoomText}" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Width="34" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Right column -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Current match + per-copy pickers -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="130" Height="181" Background="#111" CornerRadius="4" Margin="0,0,12,0">
                        <Image Source="{Binding MatchImage}" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Current match" Foreground="#8888AA" FontSize="11"/>
                        <TextBlock Text="{Binding MatchName}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding MatchDetails}" Foreground="#B8B8C0" TextWrapping="Wrap" Margin="0,3,0,0"/>

                        <!-- Printing disambiguation -->
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock Text="Printing" Foreground="#8888AA" Width="52" VerticalAlignment="Center"/>
                            <TextBlock Text="loading…" Foreground="#777" FontSize="11" DockPanel.Dock="Right"
                                       VerticalAlignment="Center" Margin="6,0,0,0"
                                       Visibility="{Binding PrintingsLoading, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"/>
                            <ComboBox ItemsSource="{Binding Printings}" SelectedItem="{Binding SelectedPrinting}"
                                      DisplayMemberPath="PrintingLabel"/>
                        </DockPanel>

                        <!-- Finish / condition / language -->
                        <WrapPanel Margin="0,8,0,0">
                            <CheckBox Content="Foil" IsChecked="{Binding CurrentFoil}" Margin="0,0,14,0"/>
                            <TextBlock Text="Cond" Foreground="#8888AA" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox ItemsSource="{Binding Conditions}" SelectedItem="{Binding CurrentCondition}" Width="64" Margin="0,0,14,0"/>
                            <TextBlock Text="Lang" Foreground="#8888AA" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedValuePath="Code" DisplayMemberPath="Name"
                                      SelectedValue="{Binding CurrentLanguage}" Width="140"/>
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Confidence:" Foreground="#8888AA" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding ConfidencePercent}" FontWeight="Bold"/>
                        </StackPanel>
                        <ProgressBar Height="5" Minimum="0" Maximum="1" Value="{Binding Confidence}" Margin="0,3,0,0" Foreground="#5AA469" Background="#333"/>
                        <TextBlock Text="{Binding MatchMethod}" Foreground="#777" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="＋ Add to library" Command="{Binding AddCurrentCommand}"/>
                            <Button Content="Scryfall ↗" Command="{Binding OpenScryfallCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Manual search -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Manual search (Scryfall)" FontWeight="Bold" Margin="0,0,0,6"/>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Search" Command="{Binding SearchCommand}" Margin="6,0,0,0"/>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="4,3">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchResult}"
                             DisplayMemberPath="PrintingLabel" Height="96" Background="#1E1E22" Foreground="#E8E8EC" BorderThickness="0"/>
                </DockPanel>
            </Border>

            <!-- Library -->
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="My Library" FontSize="15" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CollectionSummary}" Foreground="#8888AA" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBox DockPanel.Dock="Top" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="4,3" Margin="0,0,0,6" VerticalContentAlignment="Center"
                             ToolTip="Filter by name, set, or type">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Tag" Value="Filter by name, set, or type…"/>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Edit selected row -->
                    <Border DockPanel.Dock="Bottom" Background="#2E2E36" CornerRadius="4" Padding="8,6" Margin="0,8,0,0"
                            IsEnabled="{Binding HasSelection}">
                        <WrapPanel>
                            <TextBlock Text="Selected:" Foreground="#8888AA" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="－" Command="{Binding RemoveSelectedCommand}" ToolTip="Decrease quantity"/>
                            <TextBlock Text="{Binding SelectedCard.Quantity}" MinWidth="22" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                            <Button Content="＋" Command="{Binding IncrementSelectedCommand}" ToolTip="Increase quantity" Margin="0,0,14,0"/>
                            <CheckBox Content="Foil" IsChecked="{Binding SelectedCard.Foil}" Margin="0,0,14,0"/>
                            <TextBlock Text="Cond" Foreground="#8888AA" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox ItemsSource="{Binding Conditions}" SelectedItem="{Binding SelectedCard.Condition}" Width="64" Margin="0,0,14,0"/>
                            <TextBlock Text="Lang" Foreground="#8888AA" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedValuePath="Code" DisplayMemberPath="Name"
                                      SelectedValue="{Binding SelectedCard.Language}" Width="140" Margin="0,0,14,0"/>
                            <Button Content="🗑 Delete row" Command="{Binding DeleteSelectedCommand}"/>
                        </WrapPanel>
                    </Border>

                    <!-- Export -->
                    <Border DockPanel.Dock="Bottom" Background="#2E2E36" CornerRadius="4" Padding="8,6" Margin="0,8,0,0">
                        <DockPanel>
                            <TextBlock Text="Export" Foreground="#8888AA" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                            <Button DockPanel.Dock="Right" Content="Copy" Command="{Binding CopyExportCommand}"/>
                            <Button DockPanel.Dock="Right" Content="Export to file…" Command="{Binding ExportFileCommand}"/>
                            <ComboBox ItemsSource="{Binding ExportOptions}" SelectedItem="{Binding SelectedExportOption}"
                                      DisplayMemberPath="Label" Margin="0,0,8,0"/>
                        </DockPanel>
                    </Border>

                    <DataGrid ItemsSource="{Binding Collection}" SelectedItem="{Binding SelectedCard}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              Background="Transparent" RowBackground="#2E2E36" AlternatingRowBackground="#333340"
                              Foreground="#E8E8EC" GridLinesVisibility="None" BorderThickness="0"
                              CanUserAddRows="False" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="42"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Set" Binding="{Binding SetCode}" Width="52"/>
                            <DataGridTextColumn Header="#" Binding="{Binding CollectorNumber}" Width="48"/>
                            <DataGridCheckBoxColumn Header="Foil" Binding="{Binding Foil}" Width="42"/>
                            <DataGridTextColumn Header="Cond" Binding="{Binding Condition}" Width="52"/>
                            <DataGridTextColumn Header="Lang" Binding="{Binding Language}" Width="48"/>
                            <DataGridTextColumn Header="$" Binding="{Binding EffectivePrice, StringFormat=0.00}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#26262C" CornerRadius="4" Padding="10,6" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="{Binding Status}"/>
                <TextBlock Text="{Binding IndexStatus}" Foreground="#8888AA" FontSize="11" Margin="0,3,0,0"/>
                <TextBlock Text="{Binding BuildProgress}" Foreground="#7C9CD0" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
